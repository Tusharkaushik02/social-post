{
  "themeName": "Learn Design System",
  "version": "2.0.0",
  "colors": {
    "primary": "#5B5CEB",
    "primaryHover": "#4A4BD4",
    "primaryForeground": "#FFFFFF",
    "primaryMuted": "#EEF0FF",
    "accent": "#22C55E",
    "accentHover": "#16A34A",
    "accentForeground": "#FFFFFF",
    "accentMuted": "#ECFDF5",
    "background": "#F8FAFC",
    "surface": "#FFFFFF",
    "foreground": "#0F172A",
    "muted": "#64748B",
    "border": "#E2E8F0",
    "borderSubtle": "#F1F5F9",
    "error": "#EF4444",
    "warning": "#F59E0B",
    "info": "#3B82F6"
  },
  "typography": {
    "fontFamily": {
      "sans": "'Inter', ui-sans-serif, system-ui, -apple-system, sans-serif"
    },
    "scale": {
      "display": { "fontSize": "32px", "fontWeight": "700", "lineHeight": "40px", "letterSpacing": "-0.02em" },
      "title": { "fontSize": "24px", "fontWeight": "700", "lineHeight": "32px", "letterSpacing": "-0.01em" },
      "heading": { "fontSize": "20px", "fontWeight": "600", "lineHeight": "28px" },
      "body": { "fontSize": "15px", "fontWeight": "400", "lineHeight": "24px" },
      "label": { "fontSize": "13px", "fontWeight": "500", "lineHeight": "18px" },
      "caption": { "fontSize": "12px", "fontWeight": "500", "lineHeight": "16px" }
    }
  },
  "borderRadius": {
    "sm": "8px",
    "md": "12px",
    "card": "16px",
    "lg": "16px",
    "xl": "20px",
    "full": "9999px"
  },
  "shadows": {
    "card": "0 1px 3px 0 rgb(0 0 0 / 0.04), 0 1px 2px -1px rgb(0 0 0 / 0.04)",
    "soft": "0 4px 24px -4px rgb(0 0 0 / 0.08)",
    "elevated": "0 8px 30px -8px rgb(0 0 0 / 0.12)",
    "focus": "0 0 0 3px rgb(91 92 235 / 0.2)"
  },
  "spacing": {
    "unit": "4px",
    "container": "640px",
    "gutter": "16px"
  }
}
